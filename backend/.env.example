# Model provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Embedding model is TBD (S1). Schema is vector(1024); changing the
# model or dimension requires a new Alembic migration.
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024

# Database
DATABASE_URL=postgresql+psycopg://locah:locah@localhost:5432/locah

# Crawler — explicit public hostnames (INV-1), not a wildcard
CRAWL_ALLOWLIST=wlu.ca,www.wlu.ca,students.wlu.ca,legacy.wlu.ca
CRAWL_USER_AGENT=LOCAH.ai (Laurier Computing Society; contact: <email>)
CRAWL_DELAY_SECONDS=1.0
CRAWL_MAX_PAGES=5000

# Answering
RETRIEVAL_TOP_K=8
CONFIDENCE_THRESHOLD=0.35

# Analytics
K_ANONYMITY_MIN=5

# Ops
ADMIN_TOKEN=
MONTHLY_COST_CAP_CAD=60
