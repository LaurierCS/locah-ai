# Model provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Embedding model: BAAI/bge-base-en-v1.5 (768-dim). See ADR-006 in SDD §13.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSIONS=768

# Database
DATABASE_URL=postgresql+psycopg://locah:locah@localhost:5432/locah

# Crawler — explicit public hostnames (INV-1), not a wildcard
CRAWL_ALLOWLIST=wlu.ca,www.wlu.ca,students.wlu.ca,legacy.wlu.ca
CRAWL_USER_AGENT=LOCAH.ai (Laurier Computing Society; development@lauriercs.org)
CRAWL_DELAY_SECONDS=1.0
CRAWL_MAX_PAGES=5000
CRAWL_DEPTH_CAP=2
CRAWL_CONTENT_TYPES=text/html,application/pdf

# Answering
RETRIEVAL_TOP_K=8
CONFIDENCE_THRESHOLD=0.35

# Analytics
K_ANONYMITY_MIN=5

# Ops
# Bearer token for POST /api/v1/admin/crawl. Empty disables the endpoint. Generate: openssl rand -hex 32
ADMIN_TOKEN=
MONTHLY_COST_CAP_CAD=60
